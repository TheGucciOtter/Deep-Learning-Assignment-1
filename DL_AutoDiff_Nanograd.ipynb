      "source": [
        "\n",
        "def train_model(nn, x_tr, y_tr, x_val, y_val, epochs, lr=2e-3):\n",
        "    tr_loss, v_loss = [], []\n",
        "    for _ in range(epochs):\n",
        "        loss = squared_loss(y_tr, forward(x_tr, nn))\n",
        "        loss.backward()\n",
        "        update_parameters(parameters(nn), lr)\n",
        "        zero_gradients(parameters(nn))\n",
        "\n",
        "        tr_loss.append(loss.v)\n",
        "        v_loss.append(squared_loss(y_val, forward(x_val, nn)).v)\n",
        "    return tr_loss, v_loss\n",
        "\n",
        "\n",
        "# Underfitting\n",
        "nn_under = [DenseLayer(1, 1, lambda x: x.relu()), DenseLayer(1, 1, lambda x: x.identity())]\n",
        "train_loss_under, val_loss_under = train_model(nn_under, x_train, y_train, x_validation, y_validation, 20, LEARN_R)\n",
        "test_loss_under = squared_loss(y_test, forward(x_test, nn_under)).v\n",
        "print(f\"Underfitting - Train: {train_loss_under[-1]/len(x_train):.3f}, Validation: {val_loss_under[-1]/len(x_validation):.3f}, Test: {test_loss_under/len(x_test):.3f}\")\n",
        "\n",
        "\n",
        "# Just right\n",
        "nn_right = [DenseLayer(1, 8, lambda x: x.relu()), DenseLayer(8, 1, lambda x: x.identity())]\n",
        "train_loss_right, val_loss_right = train_model(nn_right, x_train, y_train, x_validation, y_validation, 200, LEARN_R)\n",
        "test_loss_right = squared_loss(y_test, forward(x_test, nn_right)).v\n",
        "print(f\"Just right - Train: {train_loss_right[-1]/len(x_train):.3f}, Validation: {val_loss_right[-1]/len(x_validation):.3f}, Test: {test_loss_right/len(x_test):.3f}\")\n",
        "\n",
        "\n",
        "# Overfitting\n",
        "indices = np.random.choice(len(x_train), size=10, replace=False)\n",
        "x_tr_small = [x_train[i] for i in indices]\n",
        "y_tr_small = [y_train[i] for i in indices]\n",
        "nn_over = [\n",
        "    DenseLayer(1, 20, lambda x: x.relu()),\n",
        "    DenseLayer(20, 20, lambda x: x.relu()),\n",
        "    DenseLayer(20, 1, lambda x: x.identity()),\n",
        "]\n",
        "\n",
        "train_loss_over, val_loss_over = train_model(nn_over, x_tr_small, y_tr_small, x_validation, y_validation, 200, LEARN_R)\n",
        "test_loss_over = squared_loss(y_test, forward(x_test, nn_over)).v\n",
        "print(f\"Overfitting - Train: {train_loss_over[-1]/len(x_tr_small):.3f}, Validation: {val_loss_over[-1]/len(x_validation):.3f}, Test: {test_loss_over/len(x_test):.3f}\")\n"
      ]
